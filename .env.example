# Plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores.
# ¡NO subas el archivo .env a GitHub!

# Token de seguridad de tu bot de Discord (Obtenlo en el portal de desarrolladores)
DISCORD_TOKEN=tu_token_aqui_123456789

# (Opcional) ID del canal donde se enviarán las bitácoras diarias
LOG_CHANNEL_ID=123456789012345678
